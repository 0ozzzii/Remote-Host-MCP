# ModelScope DSW profile for Remote Host MCP 0.1.0-alpha.1.
# Copy values from the existing live deployment without printing/committing secrets.

RHMCP_AUTH_MODE=capability
RHMCP_PATH_KEY=REUSE_EXISTING_DSWD_CAPABILITY_KEY
RHMCP_PUBLIC_HOST=REUSE_EXISTING_PUBLIC_HOSTNAME
RHMCP_BIND_HOST=127.0.0.1
RHMCP_PORT=8766

# DSW canary: keep persistent data under /mnt/workspace and isolate state from 8765.
RHMCP_ALLOWED_ROOTS=/root:/mnt/workspace:/tmp
RHMCP_STATE_DIR=/mnt/workspace/rhmcp-canary-state

RHMCP_DEFAULT_TIMEOUT_MS=30000
RHMCP_MAX_TIMEOUT_MS=90000
RHMCP_MAX_COMMAND_BYTES=8192
RHMCP_MAX_OUTPUT_BYTES=262144
RHMCP_KILL_GRACE_MS=1500

RHMCP_MAX_FILE_CHUNK_BYTES=262144
RHMCP_MAX_TRANSFER_BYTES=2147483648
RHMCP_UPLOAD_TTL_SECONDS=3600

RHMCP_MAX_JOBS=256
RHMCP_JOB_MAX_TIMEOUT_MS=604800000
RHMCP_JOB_LOG_MAX_BYTES=67108864
RHMCP_JOB_READ_MAX_BYTES=131072
RHMCP_JOB_RETENTION_SECONDS=604800
RHMCP_JOB_HEARTBEAT_SECONDS=5
RHMCP_TASKS_EXTENSION=true

RHMCP_TERMINAL_MAX_SESSIONS=16
RHMCP_TERMINAL_BUFFER_BYTES=1048576
RHMCP_TERMINAL_READ_MAX_BYTES=131072
RHMCP_TERMINAL_IDLE_SECONDS=1800
RHMCP_TERMINAL_MAX_LIFETIME_SECONDS=28800
RHMCP_TERMINAL_WAIT_MAX_MS=20000
RHMCP_TERMINAL_OSC133=true

RHMCP_JSON_RESPONSE=true
RHMCP_STATELESS_HTTP=true
RHMCP_MAX_REQUEST_BODY_BYTES=786432

# OAuth is intentionally omitted/disabled for the first real DSW cutover.
