# Remote Host MCP canonical configuration.
# RHMCP_* is the public generic namespace. Existing DSWD 2.x installations may
# keep DSW_MCP_* during migration; the compatibility layer preserves them.

# Authentication: private capability URL by default.
RHMCP_AUTH_MODE=capability
RHMCP_PATH_KEY=REPLACE_WITH_48_PLUS_RANDOM_CHARS
RHMCP_PUBLIC_HOST=mcp.invalid

# Listener. Keep loopback-only when exposing through Cloudflare Tunnel/reverse proxy.
RHMCP_BIND_HOST=127.0.0.1
RHMCP_PORT=8765

# Synchronous shell execution. Longer work belongs in job_run/job_start.
RHMCP_DEFAULT_TIMEOUT_MS=30000
RHMCP_MAX_TIMEOUT_MS=90000
RHMCP_MAX_COMMAND_BYTES=8192
RHMCP_MAX_OUTPUT_BYTES=262144
RHMCP_KILL_GRACE_MS=1500

# Filesystem tool scope. `~` is expanded by the server. This does NOT sandbox
# arbitrary shell tools; exec/job/terminal retain the service OS user's rights.
RHMCP_ALLOWED_ROOTS=~:/tmp
RHMCP_STATE_DIR=~/.local/state/remote-host-mcp

# Resumable transfer.
RHMCP_MAX_FILE_CHUNK_BYTES=262144
RHMCP_MAX_TRANSFER_BYTES=2147483648
RHMCP_UPLOAD_TTL_SECONDS=3600

# Durable background jobs.
RHMCP_MAX_JOBS=256
RHMCP_JOB_MAX_TIMEOUT_MS=604800000
RHMCP_JOB_LOG_MAX_BYTES=67108864
RHMCP_JOB_READ_MAX_BYTES=131072
RHMCP_JOB_RETENTION_SECONDS=604800
RHMCP_JOB_HEARTBEAT_SECONDS=5
RHMCP_TASKS_EXTENSION=true

# Persistent PTY.
RHMCP_TERMINAL_MAX_SESSIONS=16
RHMCP_TERMINAL_BUFFER_BYTES=1048576
RHMCP_TERMINAL_READ_MAX_BYTES=131072
RHMCP_TERMINAL_IDLE_SECONDS=1800
RHMCP_TERMINAL_MAX_LIFETIME_SECONDS=28800
RHMCP_TERMINAL_WAIT_MAX_MS=20000
RHMCP_TERMINAL_OSC133=true

# Streamable HTTP.
RHMCP_JSON_RESPONSE=true
RHMCP_STATELESS_HTTP=true
RHMCP_MAX_REQUEST_BODY_BYTES=786432

# Optional OAuth 2.1 Resource Server mode. Disabled unless AUTH_MODE=oauth.
# RHMCP_OAUTH_ISSUER=https://auth.example.com
# RHMCP_OAUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# RHMCP_OAUTH_AUDIENCE=https://host.example.com/mcp
# RHMCP_OAUTH_SCOPES=remote-host
# RHMCP_OAUTH_ALGORITHMS=RS256
